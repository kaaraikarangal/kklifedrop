{
  "expo": {
    "name": "KK Life Drop",
    "slug": "kaaraikarangal",
    "owner": "kaaraikarangal",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kklifedrop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.kaaraikarangal.kklifedrop",
      "buildNumber": "10"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "org.kaaraikarangal.kklifedrop",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D31027"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "packagingOptions": {
              "exclude": [
                "**/lib/x86/**",
                "**/lib/x86_64/**",
                "**/META-INF/DEPENDENCIES",
                "**/META-INF/LICENSE",
                "**/META-INF/LICENSE.txt",
                "**/META-INF/license.txt",
                "**/META-INF/NOTICE",
                "**/META-INF/NOTICE.txt",
                "**/META-INF/notice.txt",
                "**/META-INF/ASL2.0",
                "**/META-INF/*.kotlin_module"
              ]
            },
            "extraProguardRules": "-assumenosideeffects class android.util.Log { public static boolean isLoggable(java.lang.String, int); public static int v(...); public static int d(...); public static int i(...); }\n-dontwarn okio.**\n-dontwarn javax.annotation.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1095b63-c551-4f8d-9771-36a08668d0eb"
      },
      "backendUrl": "https://uurkvfeguglvcjqgcway.supabase.co"
    }
  }
}
